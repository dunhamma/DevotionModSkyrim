{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creation-profile.v1",
  "title": "Creation Engine Project Profile",
  "type": "object",
  "required": ["schema", "game", "modId", "sourcePlugin", "resourceConnectors"],
  "properties": {
    "schema": { "const": "creation-profile.v1" },
    "game": { "type": "string", "minLength": 1 },
    "modId": { "type": "string", "minLength": 1 },
    "sourcePlugin": { "type": "string", "minLength": 1 },
    "outputPolicy": {
      "enum": ["overlay", "generated-patch", "in-place-explicit"]
    },
    "defaultOutput": { "type": "string" },
    "reportsDir": { "type": "string" },
    "referencePack": { "type": "string" },
    "resourceConnectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "name": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "verifierRules": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
