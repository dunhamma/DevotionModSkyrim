{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creation-authoring.v1",
  "title": "Creation Engine Authoring Manifest",
  "type": "object",
  "required": ["schema", "project", "game", "sourcePlugin", "operations"],
  "properties": {
    "schema": { "const": "creation-authoring.v1" },
    "project": { "type": "string", "minLength": 1 },
    "game": { "type": "string", "minLength": 1 },
    "sourcePlugin": { "type": "string", "minLength": 1 },
    "output": { "type": "string" },
    "metadata": { "type": "object" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "target", "payload"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "payload": { "type": "object" },
          "mode": { "enum": ["create", "update", "create_or_update"] },
          "onConflict": { "enum": ["fail", "update", "rename"] },
          "recordFamily": { "type": "string", "minLength": 1 },
          "ckSemanticsRequired": { "type": "boolean" },
          "reviewIntent": { "type": "string" },
          "verifierExpectations": {
            "type": "array",
            "items": { "type": "object" }
          },
          "runtimeSmokeRequired": { "type": "boolean" },
          "mergePolicy": {
            "type": "object",
            "properties": {
              "promote": { "enum": ["reviewed", "never", "source-explicit"] },
              "preserveFormId": { "enum": ["when-safe", "always", "never"] },
              "requiresCkFinalization": { "type": "boolean" },
              "allowSourceMutation": { "type": "boolean" }
            },
            "additionalProperties": true
          },
          "mastersExpected": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requires": {
            "type": "array",
            "items": { "type": "string" }
          },
          "preferredBackend": { "type": "string" },
          "metadata": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
