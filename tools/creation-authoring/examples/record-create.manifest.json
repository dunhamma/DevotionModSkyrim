{
  "schema": "creation-authoring.v1",
  "project": "example-mod",
  "game": "SkyrimSE",
  "sourcePlugin": "ExampleMod.esp",
  "output": "ExampleMod_GeneratedRecords.esp",
  "operations": [
    {
      "id": "create-service-quest",
      "kind": "record.create",
      "target": "EXM_NewServiceQuest",
      "mode": "create",
      "onConflict": "fail",
      "recordFamily": "QUST",
      "ckSemanticsRequired": true,
      "reviewIntent": "Create the service quest that owns event receiver glue.",
      "payload": {
        "recordType": "QUST",
        "name": "Example Service Quest"
      },
      "verifierExpectations": [
        {
          "type": "fieldEquals",
          "path": "recordType",
          "value": "QUST"
        }
      ],
      "runtimeSmokeRequired": true,
      "mergePolicy": {
        "promote": "reviewed",
        "preserveFormId": "when-safe",
        "requiresCkFinalization": true
      },
      "mastersExpected": ["Skyrim.esm"]
    }
  ]
}
