generated/live-devotion-snapshot/

# Release packaging artifacts (tracked dist/ content is unaffected)
dist/Rynfri_JoJ_Package/
dist/Rynfri_JoJ_Package.zip
dist/Devotion.PreBeta.*.zip

# Untracked scratch output folders (tracked scratch/ files are unaffected)
scratch/mcm-anomaly-bsa/
