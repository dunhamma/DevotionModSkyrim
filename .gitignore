**/bin/
**/obj/

# C/C++ (xmake) build outputs
.xmake/
build/

# Log files (none are tracked)
*.log

# Generated runtime log snapshots
generated/runtime-log-snapshots/

# Generated live-mod snapshots from local proof/deploy runs. Older committed
