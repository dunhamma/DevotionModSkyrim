native/DevotionPrismaBridge/mod/PrismaUI/views/Devotion/app.js text eol=lf
native/DevotionPrismaBridge/mod/PrismaUI/views/Devotion/index.html text eol=lf
native/DevotionPrismaBridge/mod/PrismaUI/views/Devotion/styles.css text eol=lf

# The tracked Papyrus mirror. pdv_compile.mjs's drift guard compares each of
# these against the shared MO2 live tree before compiling; with autocrlf=true and
# no pin, a fresh checkout could resolve to CRLF while the live tree is LF (or the
# reverse) and the guard would report false drift. Pin LF so the checkout side is
# deterministic; the guard also normalizes line endings as the second layer.
live-source/Scripts/Source/*.psc text eol=lf

# Generated Nexus BBCode. pdv_guide_bbcode.mjs writes LF and its --check gate
# byte-compares what it would write against what is on disk; with autocrlf=true
# and no rule here, git rewrites these to CRLF on checkout and every guide then
# reports a false "stale". Pin them so the gate compares like with like.
dist/nexus-articles/*.bb text eol=lf

# Release notes are copied verbatim into the release zip by
# tools/pdv_package_release.mjs, and the handoff publishes that zip's SHA256.
# Any line-ending rewrite on checkout would change the artifact's bytes and make
# the published hash unreproducible on another machine, so store these exactly as
# they ship (README is LF, CHANGELOG is CRLF) rather than normalizing either.
dist/release-meta/README.txt -text
dist/release-meta/CHANGELOG.txt -text

# Devotion quest-mod patch FOMOD. The package ships plugins (.esp) and compiled
# scripts (.pex) as raw bytes, and the handoff publishes the zip's SHA256. Git's
# binary heuristic would probably spare them, but "probably" corrupts a plugin
# silently when it misfires, so state it. The text members are pinned LF so a zip
# rebuilt from a fresh checkout reproduces the published hash on any machine.
dist/PDV_QuestModPatches_FOMOD/**/*.esp -text
dist/PDV_QuestModPatches_FOMOD/**/*.pex -text
dist/PDV_QuestModPatches_FOMOD_*.zip -text
dist/PDV_QuestModPatches_FOMOD/**/*.json text eol=lf
dist/PDV_QuestModPatches_FOMOD/**/*.xml text eol=lf
dist/PDV_QuestModPatches_FOMOD/**/*.psc text eol=lf
dist/PDV_QuestModPatches_FOMOD/**/*.md text eol=lf
dist/PDV_QuestModPatches_FOMOD/**/*.ini text eol=lf
# Quest-reaction channels and stage adapters are GENERATED, and each one carries the
# full stance table (race x deity) and faucet table verbatim -- so a single channel is
# ~3,000 lines of which only a handful describe its own quests. Forty-odd of them made
# one branch read as a 100,000-line diff that was really the same tables repeated.
# linguist-generated collapses them in review and keeps them out of language stats.
# Deliberately NOT "-diff": these are the files you read to verify a split or a regen
# actually carried the right quests, and -diff would blind that locally as well as on
# GitHub. The eol=lf above is repeated here on purpose -- a later, more specific rule
# wins per attribute, and dropping LF would change the published zip's SHA256.
dist/PDV_QuestModPatches_FOMOD/**/Channels/*.json text eol=lf linguist-generated=true
dist/PDV_QuestModPatches_FOMOD/**/QuestStageAdapters/*.json text eol=lf linguist-generated=true
# Authoria all-in-one package. Same reasoning as the FOMOD block above: the ESP
# and compiled scripts are bytes, and the handoff publishes the zip's SHA256.
dist/Devotion_Authoria_Compatibility*.zip -text


# Quest-reaction matrix sources. pdv_quest_tranche_merge.mjs --check re-derives
# Full.csv from the tranche sources and BYTE-compares against what is on disk,
# and the tool writes CRLF. These blobs are stored LF, so on a checkout that
# does not convert (Linux/CI, or autocrlf=false) the working tree would be LF
# and the gate would report drift that does not exist. Pin the WORKING TREE to
# CRLF on every platform -- blob stays LF, so this is not a rewrite -- and the
# gate then compares like with like everywhere.
references/authoring/PDV_QuestReactionMatrix_Full.csv text eol=crlf
references/authoring/PDV_QuestReactionMatrix_Tranche*.csv text eol=crlf
references/authoring/PDV_QuestReactionMatrix_Reconciliation_*.csv text eol=crlf
