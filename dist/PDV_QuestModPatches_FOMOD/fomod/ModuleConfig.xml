<?xml version="1.0" encoding="utf-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Devotion - Quest Mod Patches</moduleName>
  <installSteps order="Explicit">
    <installStep name="Installation Mode">
      <optionalFileGroups order="Explicit">
        <group name="How do you want to install?" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Authoria (Requiem Reforged) - All-In-One">
              <description>One combined ESL-flagged hook plugin for the original dialogue patches, plus all nineteen data channels. Authoria ships every target mod. T13 channels are machine-verified test candidates pending ARR 2.5 runtime evidence.</description>
              <files>
                <folder source="common\Sirenroot" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
                <folder source="common\TheRotBelow" destination="" priority="0" />
                <folder source="common\TheFrozenHeart" destination="" priority="0" />
                <folder source="common\DepthsOfTheSoul" destination="" priority="0" />
                <folder source="common\BabaYaga" destination="" priority="0" />
                <folder source="common\BarkAndBite" destination="" priority="0" />
                <folder source="common\BeforeTheEnd" destination="" priority="0" />
                <folder source="common\WarsFolly" destination="" priority="0" />
                <folder source="common\OnceWeWereHere" destination="" priority="0" />
                <folder source="common\WhispersOfTheDepths" destination="" priority="0" />
                <folder source="common\Wyrmstooth" destination="" priority="0" />
                <folder source="common\CCTheCause" destination="" priority="0" />
                <folder source="common\CCGhostsTribunal" destination="" priority="0" />
                <folder source="common\CCDivineCrusader" destination="" priority="0" />
                <folder source="common\TasteOfDeathAddon" destination="" priority="0" />
                <folder source="common\SiegeAtIcemoth" destination="" priority="0" />
                <folder source="common\HuntForSpectre" destination="" priority="0" />
                <folder source="common\CallingTheWatchmaker" destination="" priority="0" />
                <folder source="common\GiftOfSaturalia" destination="" priority="0" />
                <folder source="common\_Fragments\WarsFolly" destination="" priority="0" />
                <folder source="common\_Fragments\OnceWeWereHere" destination="" priority="0" />
                <folder source="common\_Fragments\WhispersOfTheDepths" destination="" priority="0" />
                <folder source="plugins\authoria" destination="" priority="0" />
              </files>
              <conditionFlags>
                <flag name="mode">authoria</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="Individual patches (any other load order)">
              <description>Pick patches one by one on the next page. Each is self-contained and masters only the mod it patches, so a mod you do not have simply is not patched. Choose this for any load order other than Authoria.</description>
              <conditionFlags>
                <flag name="mode">individual</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
    <installStep name="Select Quest Mod Patches">
      <visible>
        <flagDependency flag="mode" value="individual" />
      </visible>
      <optionalFileGroups order="Explicit">
        <group name="Devotion Quest Mod Patches" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="Sirenroot">
              <description>Lays the haunting Ayleid spirit to rest: Arkay, Meridia, Stendarr, Tu'whacca, Azura, Y'ffre, plus the elven pantheon (Auri-El, Xarxes, Magnus) for the Ayleid dead, and Zenithar for honest salvage work.</description>
              <files>
                <folder source="common\Sirenroot" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="evgSIRENROOT.esm" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="The Rot Below">
              <description>Namira is named in the quest itself. Foiling her plan angers her and pleases the death-and-light gods; killing or sparing the freed lich Adabelle splits Mara and Dibella.</description>
              <files>
                <folder source="common\TheRotBelow" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="CJ03Elroy.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="The Frozen Heart">
              <description>The cursed woman is a Snow Elf, so Auri-El reacts most of all: curing her is a milestone in his eyes, killing her a grave offence. Mara, Stendarr, Trinimac and Molag Bal also weigh in.</description>
              <files>
                <folder source="common\TheFrozenHeart" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="ksws07_quest.esm" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Depths of the Soul">
              <description>Zenithar approves of helping the merchant Pike open his shop.</description>
              <files>
                <folder source="common\DepthsOfTheSoul" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="Dungeon Delver Mod.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Baba Yaga and the Labyrinth">
              <description>Mara approves of rescuing the witch from the Black Stone Labyrinth.</description>
              <files>
                <folder source="common\BabaYaga" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="ksws03_quest.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Bark and Bite">
              <description>Freeing the three werewolf spirits pleases Hircine; sparing Frija instead pleases Stendarr and disappoints him. Sheogorath is amused either way.</description>
              <files>
                <folder source="common\BarkAndBite" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="Tree Contract Mod.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Before the End">
              <description>Mara and Arkay approve of staying with the condemned man Aradell until the end.</description>
              <files>
                <folder source="common\BeforeTheEnd" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="PrisonerMod.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="War's Folly">
              <description>Adds Devotion reactions to all six stances you can take with Sandor the preacher, from pride in slaughter to renouncing the war. Includes an ESL-flagged plugin (also repairs two dialogue endings that never set their quest stage).</description>
              <files>
                <folder source="common\WarsFolly" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
                <folder source="common\_Fragments\WarsFolly" destination="" priority="0" />
                <folder source="plugins\individual\WarsFolly" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="War's Folly.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Once We Were Here">
              <description>Hoping the Falmer may yet be redeemed pleases Auri-El, their forebears' god; calling the damage irreparable disappoints him. Includes an ESL-flagged plugin.</description>
              <files>
                <folder source="common\OnceWeWereHere" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
                <folder source="common\_Fragments\OnceWeWereHere" destination="" priority="0" />
                <folder source="plugins\individual\OnceWeWereHere" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="Once We Were Here - Quest Mod.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Whispers of the Depths">
              <description>Mara approves of offering condolences to the old sailor. Includes an ESL-flagged plugin.</description>
              <files>
                <folder source="common\WhispersOfTheDepths" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
                <folder source="common\_Fragments\WhispersOfTheDepths" destination="" priority="0" />
                <folder source="plugins\individual\WhispersOfTheDepths" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="Slays-Many-Beasts Quest Mod.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Wyrmstooth (T13 experimental)">
              <description>Data-only channel for defeating Vulthurkrah while defending Stonehollow. Machine-verified; runtime evidence remains open.</description>
              <files>
                <folder source="common\Wyrmstooth" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns><pattern><dependencies operator="And"><fileDependency file="Wyrmstooth.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Creation Club - The Cause (T13 experimental)">
              <description>Data-only channel for the directly evidenced Deadlands escape and Vigil victory. Machine-verified; runtime evidence remains open.</description>
              <files>
                <folder source="common\CCTheCause" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns><pattern><dependencies operator="And"><fileDependency file="ccbgssse067-daedinv.esm" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Creation Club - Ghosts of the Tribunal (T13 experimental)">
              <description>Data-only channel for restoring Trueflame at the Dwarven forge. It grants generic craft credit, not invented Tribunal worship.</description>
              <files>
                <folder source="common\CCGhostsTribunal" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns><pattern><dependencies operator="And"><fileDependency file="ccasvsse001-almsivi.esm" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Creation Club - Divine Crusader (T13 experimental)">
              <description>Data-only nine-shrine pilgrimage channel. Objective-derived semantics require an actual quest traversal; setstage cannot clear the proof debt.</description>
              <files>
                <folder source="common\CCDivineCrusader" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns><pattern><dependencies operator="And"><fileDependency file="ccmtysse001-knightsofthenine.esl" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Taste of Death Addon (T13 experimental)">
              <description>Data-only channel for bringing Markarth's Namira cult to justice. Machine-verified; runtime evidence remains open.</description>
              <files>
                <folder source="common\TasteOfDeathAddon" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns><pattern><dependencies operator="And"><fileDependency file="TasteOfDeath_Addon_Dialogue.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Siege at Icemoth (T13 experimental)">
              <description>Data-only channels for ending the necromancer's undead army and uncovering the Font of Memory. Machine-verified; runtime evidence remains open.</description>
              <files>
                <folder source="common\SiegeAtIcemoth" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns><pattern><dependencies operator="And"><fileDependency file="Siege at Icemoth.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Hunt for the Spectre (T13 experimental)">
              <description>Data-only channel for the directly evidenced Spectre defeat. Machine-verified; runtime evidence remains open.</description>
              <files>
                <folder source="common\HuntForSpectre" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns><pattern><dependencies operator="And"><fileDependency file="Hunt for the Spectre.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Calling the Watchmaker (T13 experimental)">
              <description>Data-only channel for the explicit cold-murder branch. Machine-verified; runtime branch evidence remains open.</description>
              <files>
                <folder source="common\CallingTheWatchmaker" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns><pattern><dependencies operator="And"><fileDependency file="Sithis Mod - Lovecraftian Inspired Quest.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="The Gift of Saturalia (T13 experimental)">
              <description>Five data-only channels for the separately resolved Saturalia gifts; the umbrella completion is excluded to prevent double credit.</description>
              <files>
                <folder source="common\GiftOfSaturalia" destination="" priority="0" />
                <folder source="common\_Runbook" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns><pattern><dependencies operator="And"><fileDependency file="TheGiftofSaturalia.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
