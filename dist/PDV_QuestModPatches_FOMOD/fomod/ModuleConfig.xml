<?xml version="1.0" encoding="utf-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Devotion - Quest Reaction Compatibility</moduleName>
  <requiredInstallFiles>
    <folder source="required" destination="" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Optional Compatibility Adapters">
      <optionalFileGroups order="Explicit">
        <group name="Detected Adapter Plugins" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="Aetherium Forge Destroys Items">
              <description>This mod allows you to destroy items by dropping them in the lava at the Aetherium Forge.</description>
              <files>
                <folder source="adapters\afdi" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="Aetherium Forge Destroys Items.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Daedric Shrines AIO prayer activators">
              <description>Statues of Daedric Lords.</description>
              <files>
                <folder source="adapters\daedric-shrines-aio" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="man_DaedricShrines.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Once We Were Here">
              <description>Once We Were Here is a short to medium sized quest mod that revolves around Sillas, a Bosmer scholar investigating the Falmer.</description>
              <files>
                <folder source="adapters\once-we-were-here" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="Once We Were Here - Quest Mod.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="War's Folly">
              <description>Stumble across Sandor, a zealous preacher who seeks to convince Solitude's residents that the Civil War is one of folly. Hear his sermons and converse with the man, perhaps even you will begin to question your ideals.</description>
              <files>
                <folder source="adapters\wars-folly" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="War's Folly.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Whispers of the Depths">
              <description>Whispers of the Depths centres around an Argonian fisherman, Slays-Many-Beasts. Through the four encounters of this mod, he will tell tales of his time at sea, and the various monsters he encountered.</description>
              <files>
                <folder source="adapters\whispers-of-the-depths" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="Slays-Many-Beasts Quest Mod.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
