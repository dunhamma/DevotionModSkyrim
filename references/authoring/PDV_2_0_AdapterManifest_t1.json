  "interfaceGaps": [
    {
      "id": "G1-reason-channel",
      "severity": "blocker for the call-site remap",
      "finding": "HandleContextualSignal(String signalId, Form contextForm, Float magnitude) has no channel for the caller-supplied \"reason\" String, but 31 of the 49 dispatched t1 signal ids target a verb that takes one, and callers build it dynamically (PDV_EventBus: \"eventbus_\" + eventType; PDV__ManagerQuest: \"mcm\"). The dispatch layer therefore passes signalId in the reason slot, which changes the trace/journal string.",
      "behaviourRisk": "HandleAltmerDawnSteadiness BRANCHES on the exact reason string (\"eventbus_p2_altmer_auriel_po3_book_altmer_auriel\" / \"..._magnus_...\"), so routing it through the signal id silently takes the wrong branch. ShouldSuppressAltmerCurseModal branches on \"mcm_force_*\" reasons too.",
      "recommendation": "Amend the base virtual to HandleContextualSignal(String signalId, Form contextForm = None, Float magnitude = 0.0, String reason = \"\") -- a trailing defaulted parameter is source-compatible with every adapter written so far. Adapters must then be regenerated to pass reason through."
    },
    {
      "id": "G2-verbs-that-cannot-be-keyed",
      "severity": "needs an interface decision",
      "finding": "These t1 verbs have live external call sites but cannot be reached through the frozen 19, so they are copied into the adapter but NOT dispatched.",
      "Altmer": [
        "HandleAltmerAlignmentSignal(String actionKey, Form sourceForm, String reason) -- needs two distinct dynamic Strings (PDV_EventBus.psc:88).",
        "HandleAltmerMagicSkillIncrease(String skillName) -- skillName is dynamic (PDV_ActionRouter.psc:299); using it as the signal id would make the id set unbounded.",
        "HandleAltmerPracticeFocus(String reason) returns Int and PDV_EventBus.psc:703 RETURNS that value; HandleContextualSignal returns Bool, so the value is lost. Dispatched anyway as \"practice-focus\", with the Int discarded.",
        "GetAltmerHeritageTierJournalLine(Int tierValue) -- keyed detail accessors take a String key only.",
        "IsAltmerRejectedLorkhanSurface(String sourceId) -- a Bool read with a dynamic String argument.",
        "IsValidAltmerSourceFavorFamily(Int familyValue) -- Int argument.",
        "ApplyAltmerCurseHandlers / ShowAltmerNotification / GetAltmerFormalCommitmentOfferMessage -- see virtualsNotOverridden."
      ],
      "Bosmer": [
        "HandleBosmerLocationChange(Location loc) -- see virtualsNotOverridden.",
        "ApplyBosmerInitialChoice(Int pathState, String reason) -- see virtualsNotOverridden.",
        "ApplyBosmerPathPatron(Int pathState, String reason), SetBosmerPactBound(Bool, String), SetBosmerGreenPactCompliance(Int, String) -- external writers with typed arguments and no keyed-write verb in the interface.",
        "TryAwardBosmerYffreGreenSite(String siteKey, String reason) -- two Strings."
      ]
    },
    {
      "id": "G3-key-parameter-name",
      "severity": "compile-blocking, already worked around",
      "finding": "The base declares GetOriginDetailLabel(String key) / GetOriginDetailValue(String key). \"key\" resolves to the vanilla Key script type, so the moment an override reads it the compiler emits \"key is not a variable\". Both t1 adapters name the parameter detailKey instead (still a valid override; Papyrus matches overrides by type).",
      "recommendation": "Rename the parameter on the base to detailKey so every adapter reads the same way."
    },
    {
      "id": "G4-arity-fill-on-sync",
      "severity": "review item",
      "finding": "SyncRaceRewards() has no argument but SyncAltmerRewards / SyncBosmerRewards take an Actor playerRef that PDV_DevotionLedger.psc:3570/3575 already holds. The dispatch layer supplies Game.GetPlayer(). The only live call site (PDV_DevotionLedger.psc:3570/3575) gets playerRef from Game.GetPlayer() at :3530, so the fill is exactly equivalent there -- but it is new code, not a moved body."
    }
  ]
}
