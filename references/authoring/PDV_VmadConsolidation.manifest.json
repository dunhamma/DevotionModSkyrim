    { "kind": "setProperty", "record": "PDV_MCM", "script": "PDV_MCM", "property": "PDV_GLO_ActiveTier", "valueType": "Object", "value": "PDV_GLO_ActiveTier" },
    { "kind": "setProperty", "record": "PDV_MCM", "script": "PDV_MCM", "property": "PDV_GLO_ActiveDeityIndex", "valueType": "Object", "value": "PDV_GLO_ActiveDeityIndex" },
    { "kind": "setProperty", "record": "PDV_MCM", "script": "PDV_MCM", "property": "PDV_GLO_PatronDeity", "valueType": "Object", "value": "PDV_GLO_PatronDeity" },
