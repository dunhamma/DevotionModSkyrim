    { "kind": "setProperty", "record": "PDV_MCM", "script": "PDV_MCM", "property": "PDV_FLST_StateTracks_All", "valueType": "Object", "value": "PDV_FLST_StateTracks_All" },
    { "kind": "setProperty", "record": "PDV_MCM", "script": "PDV_MCM", "property": "PDV_FLST_Substrates_All", "valueType": "Object", "value": "PDV_FLST_Substrates_All" },
    { "kind": "setProperty", "record": "PDV_MCM", "script": "PDV_MCM", "property": "PDV_FLST_SacredPlaces_All", "valueType": "Object", "value": "PDV_FLST_SacredPlaces_All" },
