      "writerEol": "lf"
    },
    {
      "tool": "pdv_arr_matrix_decompose.mjs",
      "question": "Do decomposed ARR channel CSVs reproduce the same normalized text content?",
      "semantics": "normalized-text",
      "requiredHelpers": ["sameTextToString", "writeTextWithEol"],
      "writerEol": "lf"
    },
    {
      "tool": "pdv_quest_tranche_merge.mjs",
