{
  "schema": "pdv.file-comparison-semantics.v1",
  "rule": "Tracked text is compared and hashed after CRLF-to-LF normalization; binary artifacts, archives, receipts, and bytecode use exact bytes; tracked generated text declares its output EOL.",
  "tools": [
    {
      "tool": "pdv_1_0_endstate_gate.mjs",
      "question": "Are freshness sources unchanged in meaning, while deployed ESP evidence remains byte-exact?",
      "semantics": "mixed",
      "requiredHelpers": ["hashText", "hashBytes", "writeTextWithEol"],
      "writerEol": "lf"
    },
    {
      "tool": "pdv_arr25_discovery_batches.mjs",
      "question": "Do text inputs and regenerated worklist/manifest content match across checkout shapes?",
      "semantics": "normalized-text",
      "requiredHelpers": ["hashText", "sameTextToString", "writeTextWithEol"],
      "writerEol": "lf"
    },
    {
      "tool": "pdv_arr25_nonquest_check.mjs",
      "question": "The inventoried raw-hash helper had no call sites and was removed.",
      "semantics": "removed-dead-code",
      "requiredHelpers": [],
      "writerEol": "none"
    },
    {
      "tool": "pdv_arr25_nonquest_signature_scan.mjs",
      "question": "Do text inputs and regenerated scan/worklist/manifest content match across checkout shapes?",
      "semantics": "normalized-text",
      "requiredHelpers": ["hashText", "sameTextToString", "writeTextWithEol"],
      "writerEol": "lf"
    },
    {
      "tool": "pdv_arr25_t16_route_check.mjs",
      "question": "Do packaged and authoritative script sources have the same text content?",
      "semantics": "normalized-text",
      "requiredHelpers": ["sameText"],
      "writerEol": "none"
    },
    {
      "tool": "pdv_book_of_days_audit.mjs",
      "question": "Do repo/live UI text assets match in content and font files match in bytes?",
      "semantics": "mixed",
      "requiredHelpers": ["hashText", "hashBytes"],
      "writerEol": "none"
    },
    {
      "tool": "pdv_compile.mjs",
      "question": "Does deployed Papyrus source match tracked source content regardless of EOL?",
      "semantics": "normalized-text",
      "requiredHelpers": ["sameText"],
      "writerEol": "none"
    },
    {
      "tool": "pdv_felt_registry_gen.mjs",
      "question": "Do source hashes identify normalized tracked text and generated ledgers use stable LF?",
      "semantics": "normalized-text",
      "requiredHelpers": ["hashText", "writeTextWithEol"],
      "writerEol": "lf"
    },
    {
      "tool": "pdv_matrix_runtime_preflight.mjs",
