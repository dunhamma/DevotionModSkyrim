      "semantics": "normalized-text",
      "requiredHelpers": ["sameTextToString", "writeTextWithEol"],
      "writerEol": "crlf"
    },
    {
      "tool": "lib/pdv_patch_source_lock.mjs",
      "question": "Do optional adapter sources match normalized text hashes and their compiled PEX artifacts match exact byte hashes?",
      "semantics": "mixed",
      "requiredHelpers": ["hashText", "hashBytes", "writeTextWithEol"],
      "writerEol": "lf"
    }
  ],
  "requiredAttributes": [
