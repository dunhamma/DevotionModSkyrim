    },
    {
      "tool": "pdv_refresh_seq.mjs",
      "question": "Does the generated SEQ binary match the deployed SEQ bytes exactly?",
      "semantics": "exact-bytes",
      "requiredHelpers": ["sameBytesToBuffer"],
      "writerEol": "binary"
    },
    {
      "tool": "pdv_ship_optimization_audit.mjs",
      "question": "Do source candidates match normalized text while evidence artifacts retain exact byte hashes?",
      "semantics": "mixed",
      "requiredHelpers": ["hashText", "hashBytes", "writeTextWithEol"],
      "writerEol": "lf"
    },
    {
      "tool": "pdv_snapshot_live.mjs",
