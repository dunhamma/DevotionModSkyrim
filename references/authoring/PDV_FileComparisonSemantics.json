      "writerEol": "lf"
    },
    {
      "tool": "pdv_release_proof_refresh.mjs",
      "question": "Does the committed release proof identify the exact live ESP bytes and emit deterministic LF review/canonical JSON?",
      "semantics": "exact-bytes",
      "requiredHelpers": ["hashBytes", "writeTextWithEol"],
      "writerEol": "lf"
    },
    {
      "tool": "pdv_prisma_to_oneoh_audit.mjs",
      "question": "Do repo/live Prisma and source mirrors have the same text content?",
