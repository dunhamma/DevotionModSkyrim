  "profile": "Devotion Dev",
  "enabledMod": "Devotion-V3Dev",
  "disabledMod": "Devotion",
  "newGameOnly": true,
  "statusValues": [
    "pending",
    "pass",
    "fail",
    "blocked",
    "not_required"
  ],
  "runtimeSensitivePaths": [
    "SKSE/",
    "dist/",
    "live-source/",
    "mod-data/",
