  "logRules": {
    "failPatterns": [
      {
        "id": "pdv-error",
        "pattern": "(?:error[^\\r\\n]*PDV|PDV[^\\r\\n]*error)",
        "flags": "i"
      },
      {
        "id": "missing-property",
        "pattern": "(?:cannot be initialized|cannot be bound)[^\\r\\n]*(?:PDV_|Runtime|Manager)",
        "flags": "i"
      },
      {
        "id": "none-reference",
        "pattern": "(?:(?:None object|None reference|cannot call)[^\\r\\n]*(?:PDV_|Runtime|Manager)|(?:PDV_|Runtime|Manager)[^\\r\\n]*(?:None object|None reference|cannot call))",
        "flags": "i"
      },
      {
        "id": "stack-dump",
        "pattern": "stack dump",
        "flags": "i"
      },
      {
        "id": "queue-abort",
        "pattern": "\\[PDV\\][^\\r\\n]*(?:OVERFLOW|BROAD_SCOPE_ABORT)",
        "flags": "i"
      },
      {
        "id": "mcm-array-error",
        "pattern": "Array index[^\\r\\n]*out of range[^\\r\\n]*(?:PDV_MCM|Debug:)",
        "flags": "i"
      }
    ]
  },
